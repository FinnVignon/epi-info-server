{
  "name": "epi-info-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch apps/api/src/index.ts",
    "dev:admin": "vite --config apps/admin/vite.config.ts --host 0.0.0.0",
    "build": "tsc -p apps/api/tsconfig.json && vite build --config apps/admin/vite.config.ts",
    "start": "node dist/api/src/index.js",
    "backup:docker": "scripts/backup-server-data.sh",
    "restore:docker": "scripts/restore-server-data.sh",
    "lint": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json",
    "test": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=18.19.0",
    "npm": ">=9.2.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "multer": "^2.2.0",
    "mysql2": "^3.9.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vite": "^8.0.16"
  }
}
